Practical 5: To implement Distributed Shared Memory using Python multiprocessing, allowing multiple processes to read and write shared data safely using a shared dictionary and lock. 

import multiprocessing
import time
import random


class DistributedSharedMemory:

    def __init__(self, manager):
        self.memory = manager.dict()
        self.lock = multiprocessing.Lock()

    def write(self, key, value, process_id):

        with self.lock:
            print(
                f"\nProcess {process_id}: "
                f"Writing {value} to '{key}'",
                flush=True
            )

            self.memory[key] = value
            time.sleep(0.5)

    def read(self, key, process_id):

        with self.lock:
            value = self.memory.get(key, None)

            print(
                f"\nProcess {process_id}: "
                f"Read '{key}' = {value}",
                flush=True
            )

            return value


def process_task(process_id, memory, lock):

    print(f"\nProcess {process_id} started", flush=True)

    value = random.randint(1, 100)

    # Write to shared memory
    with lock:
        print(
            f"\nProcess {process_id}: "
            f"Writing {value} to 'shared_data'",
            flush=True
        )

        memory["shared_data"] = value
        time.sleep(0.5)

    # Wait for a random duration
    time.sleep(random.uniform(0.1, 1))

    # Read from shared memory
    with lock:
        value = memory.get("shared_data", None)

        print(
            f"\nProcess {process_id}: "
            f"Read 'shared_data' = {value}",
            flush=True
        )

    print(f"\nProcess {process_id} finished", flush=True)


if __name__ == "__main__":

    # Create the Manager in the main process
    manager = multiprocessing.Manager()

    # Create shared dictionary and lock
    dsm = DistributedSharedMemory(manager)

    processes = []

    # Start three processes
    for i in range(1, 4):

        p = multiprocessing.Process(
            target=process_task,
            args=(i, dsm.memory, dsm.lock)
        )

        processes.append(p)
        p.start()

    # Wait for all processes to finish
    for p in processes:
        p.join()

    print("\nFinal DSM Contents:")
    print(dict(dsm.memory))

    # Shut down the Manager
    manager.shutdown()

