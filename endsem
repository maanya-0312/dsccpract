Practical 1: To implement and demonstrate Inter-Process Communication (IPC) in Python using Pipes, Sockets, and Shared Memory.

Code(in python):
import multiprocessing as mp
import socket
import time
from multiprocessing import shared_memory


# 1. IPC USING PIPES
def pipe_child(conn):
    msg = conn.recv()
    print(f"[Pipe-Child] Received from parent: {msg}")
    conn.send(f"Hello Parent, I got your message: '{msg}'")
    conn.close()


def demo_pipes():
    print("\n===== 1. PIPE-BASED IPC (multiprocessing.Pipe) =====")

    parent_conn, child_conn = mp.Pipe(duplex=True)

    p = mp.Process(target=pipe_child, args=(child_conn,))
    p.start()

    parent_conn.send("Hello Child, are you there?")
    reply = parent_conn.recv()

    print(f"[Pipe-Parent] Received from child: {reply}")

    p.join()
    parent_conn.close()


# 2. IPC USING SOCKETS
def socket_server(host, port, ready_event):
    server_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server_sock.bind((host, port))
    server_sock.listen(1)

    ready_event.set()

    conn, addr = server_sock.accept()
    data = conn.recv(1024).decode()

    print(f"[Socket-Server] Received from client {addr}: {data}")

    conn.sendall(f"Server acknowledges: '{data}'".encode())

    conn.close()
    server_sock.close()


def socket_client(host, port, ready_event):
    ready_event.wait()
    time.sleep(0.2)

    client_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client_sock.connect((host, port))

    client_sock.sendall("Hello Server, this is the client!".encode())

    response = client_sock.recv(1024).decode()

    print(f"[Socket-Client] Received from server: {response}")

    client_sock.close()


def demo_sockets():
    print("\n===== 2. SOCKET-BASED IPC (TCP, localhost) =====")

    host, port = "127.0.0.1", 65432
    ready_event = mp.Event()

    server = mp.Process(
        target=socket_server,
        args=(host, port, ready_event)
    )

    client = mp.Process(
        target=socket_client,
        args=(host, port, ready_event)
    )

    server.start()
    client.start()

    server.join()
    client.join()


# 3. IPC USING SHARED MEMORY
def shared_memory_writer(shm_name, size):
    shm = shared_memory.SharedMemory(name=shm_name)

    message = b"Data written directly into shared memory!"
    shm.buf[:len(message)] = message

    print(f"[SharedMem-Writer] Wrote {len(message)} bytes into shared memory.")

    shm.close()


def shared_memory_reader(shm_name, size, done_event):
    done_event.wait()

    shm = shared_memory.SharedMemory(name=shm_name)

    data = bytes(shm.buf[:size]).rstrip(b"\x00")

    print(f"[SharedMem-Reader] Read from shared memory: {data.decode()}")

    shm.close()


def demo_shared_memory():
    print("\n===== 3. SHARED MEMORY IPC (multiprocessing.shared_memory) =====")

    size = 128
    shm = shared_memory.SharedMemory(create=True, size=size)
    done_event = mp.Event()

    writer = mp.Process(
        target=shared_memory_writer,
        args=(shm.name, size)
    )

    reader = mp.Process(
        target=shared_memory_reader,
        args=(shm.name, size, done_event)
    )

    reader.start()
    writer.start()

    writer.join()
    done_event.set()
    reader.join()

    shm.close()
    shm.unlink()


# MAIN DRIVER
if __name__ == "__main__":
    print("=====================================================")
    print(" IPC PRACTICAL: PIPES | SOCKETS | SHARED MEMORY ")
    print("=====================================================")

    demo_pipes()
    demo_sockets()
    demo_shared_memory()

    print("\nAll three IPC demonstrations completed successfully.")

