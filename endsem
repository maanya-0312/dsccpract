class Process:

    def __init__(self, pid, total_processes):
        self.pid = pid
        self.total_processes = total_processes

        self.clock = 0
        self.state = "RELEASED"

        self.request_timestamp = None
        self.replies_received = set()
        self.deferred_requests = []

    # Request Critical Section
    def request_critical_section(self, processes):

        self.clock += 1

        self.request_timestamp = self.clock
        self.state = "WANTED"

        self.replies_received = set()

        print(f"\nP{self.pid}: Requesting Critical Section")
        print(f"P{self.pid}: Timestamp = {self.request_timestamp}")

        # Send REQUEST to all other processes
        for process in processes:

            if process.pid != self.pid:

                process.receive_request(
                    self.pid,
                    self.request_timestamp,
                    self
                )

    # Receive REQUEST
    def receive_request(
        self,
        sender_pid,
        sender_timestamp,
        sender_process
    ):

        # Update logical clock
        self.clock = max(
            self.clock,
            sender_timestamp
        ) + 1

        print(
            f"P{self.pid}: Received REQUEST from "
            f"P{sender_pid}"
        )

        send_reply = False

        # CASE 1: Process is RELEASED
        if self.state == "RELEASED":

            send_reply = True

        # CASE 2: Process is WANTED
        elif self.state == "WANTED":

            my_request = (
                self.request_timestamp,
                self.pid
            )

            sender_request = (
                sender_timestamp,
                sender_pid
            )

            # Smaller timestamp gets priority
            if sender_request < my_request:

                send_reply = True

        # CASE 3: Process is HELD
        elif self.state == "HELD":

            send_reply = False

        # Send or defer REPLY
        if send_reply:

            print(
                f"P{self.pid}: Sending REPLY to "
                f"P{sender_pid}"
            )

            sender_process.receive_reply(self.pid)

        else:

            print(
                f"P{self.pid}: Deferring REQUEST from "
                f"P{sender_pid}"
            )

            self.deferred_requests.append(sender_process)

    # Receive REPLY
    def receive_reply(self, sender_pid):

        self.replies_received.add(sender_pid)

        print(
            f"P{self.pid}: Received REPLY from "
            f"P{sender_pid}"
        )

        # Enter CS only after receiving REPLY
        # from all other processes

        if (
            self.state == "WANTED"
            and len(self.replies_received)
            == self.total_processes - 1
        ):

            self.enter_critical_section()

    # Enter Critical Section
    def enter_critical_section(self):

        self.state = "HELD"

        print(
            f"\n>>> P{self.pid} ENTERED "
            f"CRITICAL SECTION <<<"
        )

        print(
            f"P{self.pid}: Performing critical work..."
        )

        self.exit_critical_section()

    # Exit Critical Section
    def exit_critical_section(self):

        print(
            f">>> P{self.pid} EXITED "
            f"CRITICAL SECTION <<<\n"
        )

        self.state = "RELEASED"
        self.request_timestamp = None

        # Send REPLY to deferred processes
        for process in self.deferred_requests:

            print(
                f"P{self.pid}: Sending deferred "
                f"REPLY to P{process.pid}"
            )

            process.receive_reply(self.pid)

        # Clear deferred requests
        self.deferred_requests.clear()


# CREATE PROCESSES

