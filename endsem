 Bully algorithm: 
# Bully Algorithm for Leader Election

class Process:
    def __init__(self, process_id, all_processes):
        self.process_id = process_id
        self.all_processes = all_processes
        self.active = True
        self.coordinator = None

    def send_request(self):
        print(f"\nP{self.process_id} -> P{self.coordinator}: REQUEST")

        coordinator_process = self.all_processes[self.coordinator]

        if coordinator_process.active:
            print(f"P{self.coordinator} -> P{self.process_id}: ALIVE")
            print("Coordinator is alive. No election required.")
        else:
            print("No response received.")
            print("TIMEOUT: Coordinator has failed.")
            self.start_election()

    def start_election(self):
        print(f"\nP{self.process_id} starts an election.")

        higher_processes = [
            p for p in self.all_processes.values()
            if p.process_id > self.process_id and p.active
        ]

        if not higher_processes:
            self.become_coordinator()
            return

        for process in higher_processes:
            print(
                f"P{self.process_id} -> "
                f"P{process.process_id}: ELECTION"
            )
            print(
                f"P{process.process_id} -> "
                f"P{self.process_id}: ALIVE"
            )

        # The highest active process continues the election.
        highest_process = max(
            higher_processes,
            key=lambda p: p.process_id
        )

        highest_process.start_election()

    def become_coordinator(self):
        self.coordinator = self.process_id

        print(
            f"\nP{self.process_id} becomes the NEW COORDINATOR."
        )

        for process in self.all_processes.values():
            if process.active and process.process_id != self.process_id:
                process.coordinator = self.process_id
                print(
                    f"P{self.process_id} -> "
                    f"P{process.process_id}: COORDINATOR"
                )


# Create five processes: P1, P2, P3, P4, P5
processes = {}

for i in range(1, 6):
    processes[i] = Process(i, processes)

# Initially, P5 is the coordinator
for process in processes.values():
    process.coordinator = 5

print("Initial Coordinator: P5")

# Simulate failure of P5
processes[5].active = False
print("\nP5 has failed!")

# P2 detects the failure and starts the election
processes[2].send_request()

