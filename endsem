Practical 3: To implement and demonstrate Vector Clocks in a distributed system to maintain the logical ordering of events among multiple processes. 

# Practical 3: Vector Clocks

# Number of processes
N = 3

# Initial vector clocks
P1 = [0, 0, 0]
P2 = [0, 0, 0]
P3 = [0, 0, 0]

print("Initial Clocks")
print("P1:", P1)
print("P2:", P2)
print("P3:", P3)


# Event 1: Internal event in Process 1
P1[0] += 1

print("\n--- Event 1 ---")
print("Process 1 Internal Event :", P1)


# Event 2: Process 1 sends a message
P1[0] += 1

# Attach the current vector clock to the message
message = P1.copy()

print("\n--- Event 2 ---")
print("Process 1 Sent Message :", message)


# Event 3: Internal event in Process 2
P2[1] += 1

print("\n--- Event 3 ---")
print("Process 2 Internal Event :", P2)


# Event 4: Process 2 receives the message
# Merge the received clock with the local clock
for i in range(N):
    P2[i] = max(P2[i], message[i])

# Increment Process 2's own clock
P2[1] += 1

print("\n--- Event 4 ---")
print("Process 2 Received Message :", P2)


# Event 5: Internal event in Process 3
P3[2] += 1

print("\n--- Event 5 ---")
print("Process 3 Internal Event :", P3)


# Display final vector clocks
print("\nFinal Vector Clocks")
print("P1:", P1)
print("P2:", P2)
print("P3:", P3)

