        total += subtotal;

        message += item.name +
            "\nPrice: ₹" + item.price +
            "\nQuantity: " + item.quantity +
            "\nSubtotal: ₹" + subtotal +
            "\n\n";
    });

    message += "TOTAL: ₹" + total;

    const removeItem = confirm(
        message +
        "\n\nClick OK to clear the cart, or Cancel to keep shopping."
    );

    if (removeItem) {
        cart = [];
        updateCartCount();
        alert("Your cart has been cleared.");
    }
}

