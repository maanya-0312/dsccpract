from cassandra.cluster import Cluster
from cassandra import ConsistencyLevel
import time


# =========================================================
# CONNECT TO CASSANDRA
# =========================================================

print("=" * 75)
print("CONNECTING TO APACHE CASSANDRA")
print("=" * 75)

cluster = Cluster(["127.0.0.1"])
session = cluster.connect("consistency_demo")

print("Connected to Cassandra successfully.\n")


# =========================================================
# HELPER FUNCTION
# =========================================================

def read_value(table, key, consistency):
    """
    Read a key using the specified Cassandra consistency level.
    """

    query = f"""
        SELECT key, value, version
        FROM {table}
        WHERE key = ?
    """

    statement = session.prepare(query)
    statement.consistency_level = consistency

    row = session.execute(statement, [key]).one()

    if row:
        return row.key, row.value, row.version

    return None


# =========================================================
# 1. EVENTUAL CONSISTENCY
# =========================================================

def demonstrate_eventual_consistency():

    print("\n")
    print("=" * 75)
    print("1. EVENTUAL CONSISTENCY")
    print("=" * 75)

    key = "eventual_key"

    # -----------------------------------------------------
    # WRITE USING ONE
    # -----------------------------------------------------

    insert = session.prepare("""
        INSERT INTO kv_store(key, value, version)
        VALUES (?, ?, ?)
    """)

    insert.consistency_level = ConsistencyLevel.ONE

    session.execute(
        insert,
        [key, "Version-1", 1]
    )

    print("\nWRITE OPERATION")
    print("-" * 75)
    print("Value              : Version-1")
    print("Write Consistency  : ONE")
    print("Required replicas  : At least ONE replica must acknowledge")
    
    # -----------------------------------------------------
    # READ USING ONE
    # -----------------------------------------------------

    result = read_value(
        "kv_store",
        key,
        ConsistencyLevel.ONE
    )

    print("\nIMMEDIATE READ")
    print("-" * 75)
    print("Read Consistency   : ONE")
    print("Result             :", result)

    print("""
Explanation:
At consistency level ONE, Cassandra requires only one
replica to respond successfully.

The write may not have reached every replica at the
same time. Cassandra's replication and repair mechanisms
eventually bring replicas into agreement.

Therefore, this demonstrates the configuration that
allows eventual consistency.

Note:
A stale read is not guaranteed to occur in this simple
single-node/local demonstration.
""")

    # -----------------------------------------------------
    # LATER READ USING QUORUM
    # -----------------------------------------------------

    time.sleep(2)

    result = read_value(
        "kv_store",
        key,
        ConsistencyLevel.QUORUM
    )

    print("LATER QUORUM READ")
    print("-" * 75)
    print("Read Consistency   : QUORUM")
    print("Result             :", result)

    print("""
Conclusion:
The value is expected to converge to the latest value
as replicas become synchronized.

EVENTUAL CONSISTENCY DEMONSTRATED
""")


# =========================================================
# 2. STRONG / LINEARIZABLE CONSISTENCY
# =========================================================

def demonstrate_strong_consistency():

    print("\n")
    print("=" * 75)
    print("2. STRONG / LINEARIZABLE CONSISTENCY")
    print("=" * 75)

    key = "strong_key"

    # -----------------------------------------------------
    # INITIAL VALUE
    # -----------------------------------------------------

    insert = session.prepare("""
        INSERT INTO kv_store(key, value, version)
        VALUES (?, ?, ?)
    """)

    insert.consistency_level = ConsistencyLevel.QUORUM

    session.execute(
        insert,
        [key, "Initial", 1]
    )

    print("\nINITIAL WRITE")
    print("-" * 75)
    print("Value              : Initial")
    print("Version            : 1")
    print("Write Consistency  : QUORUM")

    # -----------------------------------------------------
    # LIGHTWEIGHT TRANSACTION
    # -----------------------------------------------------

    lwt_query = """
        UPDATE kv_store
        SET value = ?, version = ?
        WHERE key = ?
        IF version = ?
    """

    lwt = session.prepare(lwt_query)

    # SERIAL is the consistency level used for the
    # Paxos phase of the Lightweight Transaction.
    lwt.serial_consistency_level = ConsistencyLevel.SERIAL

    result = session.execute(
        lwt,
        ["Strong-Version", 2, key, 1]
    ).one()

    print("\nLIGHTWEIGHT TRANSACTION")
    print("-" * 75)
    print("Condition          : version = 1")
    print("New value          : Strong-Version")
    print("New version        : 2")
    print("Serial consistency : SERIAL")
    print("LWT Result         :", result)

    # -----------------------------------------------------
    # READ USING QUORUM
    # -----------------------------------------------------

    result = read_value(
        "kv_store",
        key,
        ConsistencyLevel.QUORUM
    )

    print("\nQUORUM READ")
    print("-" * 75)
    print("Result             :", result)

    print("""
Explanation:
Cassandra Lightweight Transactions (LWT) use Paxos to
coordinate conditional updates.

The update is performed only if the condition:

    version = 1

is true.

Once another transaction changes the version to 2,
another transaction using IF version = 1 will fail.

This provides linearizable behavior for the
conditional operation.

STRONG / LINEARIZABLE CONSISTENCY DEMONSTRATED
""")


# =========================================================
# 3. CAUSAL CONSISTENCY
# =========================================================

def demonstrate_causal_consistency():

    print("\n")
    print("=" * 75)
    print("3. CAUSAL CONSISTENCY")
    print("=" * 75)

    key1 = "message"
    key2 = "reply"

    # -----------------------------------------------------
    # PREPARE INSERT
    # -----------------------------------------------------

    insert = session.prepare("""
        INSERT INTO causal_store(key, value, version)
        VALUES (?, ?, ?)
    """)

    insert.consistency_level = ConsistencyLevel.QUORUM

    # -----------------------------------------------------
    # OPERATION A
    # -----------------------------------------------------

    session.execute(
        insert,
        [key1, "Message created", 1]
    )

    print("\nOPERATION A")
    print("-" * 75)
    print("Message created")
    print("Version          : 1")
    print("Consistency      : QUORUM")
    print("Status           : COMPLETED")

    # -----------------------------------------------------
    # OPERATION B
    # -----------------------------------------------------
    # B starts only AFTER A has completed.

    session.execute(
        insert,
        [key2, "Reply to message", 2]
    )

    print("\nOPERATION B")
    print("-" * 75)
    print("Reply to message")
    print("Version          : 2")
    print("Consistency      : QUORUM")
    print("Status           : COMPLETED")

    print("""
CAUSAL RELATIONSHIP

    Operation A
        |
        | A completes first
        v
    Operation B

Because Operation B is executed only after Operation A
has completed, the application explicitly preserves
the causal dependency:

    A -> B
""")

    # -----------------------------------------------------
    # READ BOTH OPERATIONS
    # -----------------------------------------------------

    a = read_value(
        "causal_store",
        key1,
        ConsistencyLevel.QUORUM
    )

    b = read_value(
        "causal_store",
        key2,
        ConsistencyLevel.QUORUM
    )

    print("READ RESULTS")
    print("-" * 75)
    print("READ A:", a)
    print("READ B:", b)

    # -----------------------------------------------------
    # CHECK CAUSAL ORDER
    # -----------------------------------------------------

    if a and b and a[2] < b[2]:

        print("\nCausal order preserved:")
        print("A (version 1) -> B (version 2)")

    else:

        print("\nCausal order NOT preserved")

    print("""
Important:
Cassandra does not have a single consistency level named
'CAUSAL'.

This experiment demonstrates causal ordering at the
APPLICATION level. The application ensures that B is
performed only after A completes.

CAUSAL CONSISTENCY / CAUSAL ORDERING DEMONSTRATED
""")


# =========================================================
# 4. SEQUENTIAL CONSISTENCY
# =========================================================

def demonstrate_sequential_consistency():

    print("\n")
    print("=" * 70)
    print("4. SEQUENTIAL CONSISTENCY")
    print("=" * 70)

    key = 'counter'

    # -----------------------------------------------------
    # STEP 1: RESET COUNTER
    # -----------------------------------------------------

    reset_query = """
        INSERT INTO sequential_store(id, value)
        VALUES (?, ?)
    """

    reset_statement = session.prepare(reset_query)
    reset_statement.consistency_level = ConsistencyLevel.QUORUM

    session.execute(
        reset_statement,
        [key, 0]
    )

    print("\nInitial value:")
    print("Counter = 0")

    # -----------------------------------------------------
    # VERIFY INITIAL VALUE
    # -----------------------------------------------------

    read_query = """
        SELECT id, value
        FROM sequential_store
        WHERE id = ?
    """

    read_statement = session.prepare(read_query)
    read_statement.consistency_level = ConsistencyLevel.QUORUM

    row = session.execute(
        read_statement,
        [key]
    ).one()

    print("Verified value =", row.value)

    # -----------------------------------------------------
    # OPERATION 1
    # -----------------------------------------------------

    operation1_query = """
        UPDATE sequential_store
        SET value = 1
        WHERE id = ?
        IF value = 0
    """

    operation1 = session.prepare(operation1_query)

    operation1.consistency_level = ConsistencyLevel.QUORUM
    operation1.serial_consistency_level = ConsistencyLevel.SERIAL

    result1 = session.execute(
        operation1,
        [key]
    ).one()

    print("\nOperation 1:")
    print("0 -> 1")
    print("Condition: Current value must be 0")
    print("Result:", result1)

    # -----------------------------------------------------
    # VERIFY OPERATION 1
    # -----------------------------------------------------

    row = session.execute(
        read_statement,
        [key]
    ).one()

    print("Value after Operation 1 =", row.value)

    # -----------------------------------------------------
    # OPERATION 2
    # -----------------------------------------------------

    operation2_query = """
        UPDATE sequential_store
        SET value = 2
        WHERE id = ?
        IF value = 1
    """

    operation2 = session.prepare(operation2_query)

    operation2.consistency_level = ConsistencyLevel.QUORUM
    operation2.serial_consistency_level = ConsistencyLevel.SERIAL

    result2 = session.execute(
        operation2,
        [key]
    ).one()

    print("\nOperation 2:")
    print("1 -> 2")
    print("Condition: Current value must be 1")
    print("Result:", result2)

    # -----------------------------------------------------
    # FINAL VALUE
    # -----------------------------------------------------

    row = session.execute(
        read_statement,
        [key]
    ).one()

    print("\nFinal value:")
    print("Counter =", row.value)

    # -----------------------------------------------------
    # EXPLANATION
    # -----------------------------------------------------

    print("""
------------------------------------------------------------
SEQUENTIAL CONSISTENCY EXPLANATION
------------------------------------------------------------

Initial value:
    0

Operation 1:
    0 -> 1

Operation 2:
    1 -> 2

Therefore:

    0 -> 1 -> 2

Operation 2 expects the current value to be 1.
Therefore, Operation 2 can succeed only after
Operation 1 has successfully changed the value
from 0 to 1.

The operations are therefore performed in a
clear sequential order.

Final value = 2

SEQUENTIAL CONSISTENCY DEMONSTRATED
------------------------------------------------------------
""")


# =========================================================
# MAIN PROGRAM
# =========================================================

if __name__ == "__main__":

    try:

        demonstrate_eventual_consistency()

        demonstrate_strong_consistency()

        demonstrate_causal_consistency()

