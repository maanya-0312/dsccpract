Code: 
# ============================================================
# LOAD BALANCER USING ROUND ROBIN AND LEAST CONNECTION
# ============================================================


# ------------------------------------------------------------
# SERVER CLASS
# ------------------------------------------------------------

class Server:

    def __init__(self, server_id):
        self.server_id = server_id
        self.connections = 0
        self.total_requests = 0

    def handle_request(self, request_id):

        self.connections += 1
        self.total_requests += 1

        print(
            f"Request {request_id} assigned to "
            f"Server {self.server_id}"
        )

    def release_connection(self):

        if self.connections > 0:
            self.connections -= 1


# ------------------------------------------------------------
# ROUND ROBIN LOAD BALANCER
# ------------------------------------------------------------

class RoundRobinLoadBalancer:

    def __init__(self, servers):

        self.servers = servers
        self.current_index = 0

    def get_server(self):

        server = self.servers[self.current_index]

        self.current_index = (
            self.current_index + 1
        ) % len(self.servers)

        return server


# ------------------------------------------------------------
# LEAST CONNECTION LOAD BALANCER
# ------------------------------------------------------------

class LeastConnectionLoadBalancer:

    def __init__(self, servers):

        self.servers = servers

    def get_server(self):

        return min(
            self.servers,
            key=lambda server: server.connections
        )


# ------------------------------------------------------------
# CREATE SERVERS
# ------------------------------------------------------------

def create_servers(number_of_servers):

    return [
        Server(i + 1)
        for i in range(number_of_servers)
    ]


# ============================================================
# ROUND ROBIN SIMULATION
# ============================================================

def simulate_round_robin(
    number_of_servers,
    number_of_requests
):

    servers = create_servers(number_of_servers)

    load_balancer = RoundRobinLoadBalancer(servers)

    print("\n")
    print("=" * 60)
    print("ROUND ROBIN LOAD BALANCER")
    print("=" * 60)

    for request_id in range(
        1,
        number_of_requests + 1
    ):

        server = load_balancer.get_server()

        server.handle_request(request_id)

    print("\n" + "-" * 60)
    print("FINAL RESULT")
    print("-" * 60)

    for server in servers:

        print(
            f"Server {server.server_id}: "
            f"{server.total_requests} requests handled"
        )


# ============================================================
# LEAST CONNECTION SIMULATION
# ============================================================

def simulate_least_connection(
    number_of_servers,
    number_of_requests
):

    servers = create_servers(number_of_servers)

    load_balancer = LeastConnectionLoadBalancer(servers)

    print("\n")
    print("=" * 60)
    print("LEAST CONNECTION LOAD BALANCER")
    print("=" * 60)

    for request_id in range(
        1,
        number_of_requests + 1
    ):

        # Select server with minimum connections
        server = load_balancer.get_server()

        # Assign request
        server.handle_request(request_id)

        # Display current connections
        print(
            "Current Connections:",
            [
                server.connections
                for server in servers
            ]
        )

        # Simulate completion after every 2 requests
        if request_id % 2 == 0:

            busy_servers = [
                server
                for server in servers
                if server.connections > 0
            ]

            if busy_servers:

                # Release connection from the
                # first busy server
                completed_server = busy_servers[0]

                completed_server.release_connection()

                print(
                    f"Request completed on "
                    f"Server {completed_server.server_id}"
                )

    print("\n" + "-" * 60)
    print("FINAL RESULT")
    print("-" * 60)

    for server in servers:

        print(
            f"Server {server.server_id}: "
            f"{server.total_requests} requests handled, "
            f"{server.connections} active connections"
        )


# ============================================================
# MAIN PROGRAM
# ============================================================

number_of_servers = 3
number_of_requests = 10


# Run Round Robin
simulate_round_robin(
    number_of_servers,
    number_of_requests
)


# Run Least Connection
simulate_least_connection(
    number_of_servers,
    number_of_requests
)
